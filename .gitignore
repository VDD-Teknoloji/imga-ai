# Eski imga sistemleri — Sprint 8.3.5 reference only, repo'ya commit edilmez.
# Mevcut sistemden önce yazılmış Streamlit prototipleri; özellikleri yeni
# mimariye taşırken docs/analysis/ altındaki rapor üzerinden çalışılıyor.
/cx_sentiment_dashboard/
/dedas_cx_sentiment_dashboard/

# Sprint 8.3.6 — Fernet master key for tenant LLM credential encryption.
# Production key lives at /etc/imga-secrets/master.key on the host; test
# stack mounts a generated key from infra/imga/test/secrets/. Losing
# this file invalidates every encrypted credential, so it stays out of
# git but on backed-up infrastructure.
infra/imga/*/secrets/

# Sprint handoff patches — temporary transfer artefact between agents,
# never checked in (handoff itself lives under docs/handoffs/).
sprint-*.patch

# QA / smoke test result Excel'leri — UML + OTAN'dan gelen test çıktıları
# repo'da değil, lokal review için tutuluyor. Bulgular task / commit
# mesajına geçer, kaynak dosya değil.
test sonuç*.xlsx
*test sonuç*.xlsx
*test_sonuc*.xlsx
