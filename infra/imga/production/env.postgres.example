# /etc/imga/production/postgres.env (mode 600, root:root)
#
# Postgres container ilk başlatıldığında bu üç parolayı kullanarak
# imga_owner / imga_app / imga_admin rollerini yaratır (init script:
# packages/imga-db/sql/01-init-roles.sh).
#
# Üretim için her parolayı bağımsız ve güçlü tut:
#   openssl rand -base64 32
#
# DB ilk başlatıldıktan sonra parola değiştirmek volume'u sıfırlamadan
# olmuyor — başlangıçta doğru kur, password manager'a kaydet.

# imga_owner — DDL + migration sahibi, BYPASSRLS yapısı yok ama owner
POSTGRES_PASSWORD=

# imga_app — uygulamanın çalışma rolü (RLS uygulanır)
IMGA_APP_PASSWORD=

# imga_admin — super-admin endpoint'leri (BYPASSRLS)
IMGA_ADMIN_PASSWORD=
