# /etc/imga/production/api.env (mode 600, root:root)
#
# api container'ın çalışma zamanı env değişkenleri.
#
# DATABASE_URL_* parolaları postgres.env'dakilerle birebir aynı
# olmalı — orada tanımlanır, burada bağlantı string'i içinde
# tekrar geçer (bağlanmak için bilmesi lazım).

# --- DB bağlantıları ---------------------------------------------------
# Aynı host (postgres container'ı, isim: imga-prod-postgres → compose
# içinde "postgres" service adıyla DNS'i çözülür); 3 farklı rol:
DATABASE_URL=postgresql+asyncpg://imga_app:<APP_PWD>@postgres:5432/imga
DATABASE_URL_ADMIN=postgresql+asyncpg://imga_admin:<ADMIN_PWD>@postgres:5432/imga
DATABASE_URL_OWNER=postgresql+asyncpg://imga_owner:<OWNER_PWD>@postgres:5432/imga

# --- JWT --------------------------------------------------------------
# En az 32 byte random; replay-protection ve rotation chain için kritik.
#   openssl rand -base64 32
JWT_SECRET_KEY=

# --- CORS -------------------------------------------------------------
# Frontend'in origin'i — sadece bu listedeki origin'ler API'ye preflight
# geçirebilir.
IMGA_CORS_ORIGINS=https://app.imga.ai

# --- LLM fallback (opsiyonel — şimdilik kapalı) ----------------------
IMGA_LLM_FALLBACK_ENABLED=false
# IMGA_LLM_PROVIDER=gemini
# GEMINI_API_KEY=

# --- Logging / observability -----------------------------------------
ENVIRONMENT=production
LOG_LEVEL=info

# Sprint 8.5'te eklenecek — Sentry projesi açıldığında DSN buraya
# SENTRY_DSN=
# RELEASE_SHA=  (CI/CD pipeline'ı tarafından eklenir)
