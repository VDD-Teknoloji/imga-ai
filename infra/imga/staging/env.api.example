# /etc/imga/staging/api.env (mode 600, root:root)
#
# Production şablonuyla aynı yapı; farklılıklar:
#   * DB hostname içeride "postgres" (staging compose'da da aynı service adı)
#     ama container hostname imga-staging-postgres — internal network
#     izolasyonu sayesinde production'la karışmaz
#   * IMGA_CORS_ORIGINS staging frontend'ini gösterir
#   * JWT_SECRET_KEY production'dakiyle FARKLI olmalı

DATABASE_URL=postgresql+asyncpg://imga_app:<APP_PWD>@postgres:5432/imga
DATABASE_URL_ADMIN=postgresql+asyncpg://imga_admin:<ADMIN_PWD>@postgres:5432/imga
DATABASE_URL_OWNER=postgresql+asyncpg://imga_owner:<OWNER_PWD>@postgres:5432/imga

JWT_SECRET_KEY=

IMGA_CORS_ORIGINS=https://staging.imga.ai

IMGA_LLM_FALLBACK_ENABLED=false

ENVIRONMENT=staging
LOG_LEVEL=info
