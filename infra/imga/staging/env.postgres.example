# /etc/imga/staging/postgres.env (mode 600, root:root)
#
# Production ile aynı şekil ama farklı parolalar (production parolaları
# staging'i kontrol edemez ve tam tersi). Production parolasıyla aynı
# yapma — staging'de yapılan bir hata production'a sızmamalı.
#
#   openssl rand -base64 32

POSTGRES_PASSWORD=
IMGA_APP_PASSWORD=
IMGA_ADMIN_PASSWORD=
