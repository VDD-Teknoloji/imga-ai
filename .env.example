# Copy to .env and adjust for your environment.

# === Host ports ===
# Host port for the Streamlit UI. Change if 8501 is already taken on your server.
IMGA_LEGACY_PORT=8501

# Host port for the FastAPI service.
IMGA_API_PORT=8000

# Host port for the new dashboard (Sprint 4).
IMGA_DASHBOARD_PORT=8502

# Host port for PostgreSQL (Sprint 7).
IMGA_POSTGRES_PORT=5432

# === Database (Sprint 7) ===
# Three-role model:
#   imga_owner -- migrations only (alembic upgrade/downgrade)
#   imga_app   -- normal API requests, NOBYPASSRLS, all RLS policies enforced
#   imga_admin -- super-admin endpoints only, BYPASSRLS for cross-tenant queries
POSTGRES_PASSWORD=imga_dev_password
IMGA_APP_PASSWORD=imga_app_password
IMGA_ADMIN_PASSWORD=imga_admin_password

# Connection strings consumed by the API (use postgres hostname inside docker
# network, localhost when running outside).
DATABASE_URL_OWNER=postgresql+asyncpg://imga_owner:imga_dev_password@postgres:5432/imga
DATABASE_URL=postgresql+asyncpg://imga_app:imga_app_password@postgres:5432/imga
DATABASE_URL_ADMIN=postgresql+asyncpg://imga_admin:imga_admin_password@postgres:5432/imga

# === JWT (Sprint 7.3) ===
JWT_SECRET_KEY=change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# === Super Admin bootstrap (Sprint 7.1) ===
# The first migration seeds this account; the password must be rotated on
# first login (Sprint 7.3 enforces this).
SUPER_ADMIN_EMAIL=admin@imga.ai
SUPER_ADMIN_INITIAL_PASSWORD=change_on_first_login

# === Data + state ===
# Host directory bind-mounted to /data inside containers.
# Holds cx_rules.json, cx_params.json, training_data.csv across restarts.
IMGA_DATA_PATH=./data

# === LLM-based category classification (Sprint 6) ===
# Provider for low-confidence category classification fallback.
# Supported: "gemini" (active). "claude" raises NotImplementedError.
IMGA_LLM_PROVIDER=gemini

# Set to "true" to activate LLM fallback. When false (default), low-confidence
# classifications return 'belirsiz' with requires_manual_review=true and the
# operator decides — keyword classifier alone runs.
IMGA_LLM_FALLBACK_ENABLED=false

# Gemini (Google AI Studio - free tier).
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
IMGA_GEMINI_MODEL=gemini-2.5-flash

# Future provider — not yet implemented:
# ANTHROPIC_API_KEY=
# IMGA_CLAUDE_MODEL=claude-haiku-4-5-20251001
