# Copy to .env and adjust for your environment.

# Host port for the Streamlit UI. Change if 8501 is already taken on your server.
IMGA_LEGACY_PORT=8501

# Host port for the FastAPI service.
IMGA_API_PORT=8000

# Host port for the new dashboard (Sprint 4).
IMGA_DASHBOARD_PORT=8502

# Host directory bind-mounted to /data inside containers.
# Holds cx_rules.json, cx_params.json, training_data.csv across restarts.
IMGA_DATA_PATH=./data
