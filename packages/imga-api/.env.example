# Local dev defaults. Copy to .env (or .env.local for personal overrides)
# in this directory and uvicorn will pick them up automatically:
#
#     cp .env.example .env
#     uvicorn imga_api.main:app --port 8003 --reload
#
# Production deployments should not use this file — env vars come from
# the orchestrator.

# Three DB roles. localhost:5433 matches docker-compose's default
# IMGA_POSTGRES_PORT mapping; if you've changed it, update here.
DATABASE_URL=postgresql+asyncpg://imga_app:imga_app_password@localhost:5433/imga
DATABASE_URL_ADMIN=postgresql+asyncpg://imga_admin:imga_admin_password@localhost:5433/imga
DATABASE_URL_OWNER=postgresql+asyncpg://imga_owner:imga_dev_password@localhost:5433/imga

# JWT — anything 32 chars or longer works for local dev.
JWT_SECRET_KEY=test-secret-key-32-bytes-min-padding-xyz

# Optional: data files for the analysis pipeline (used by /analyze).
# Leave commented if you don't need to run /analyze locally.
# IMGA_KB_PATH=../../data/training_data.csv
# IMGA_RULES_PATH=../../data/cx_rules.json

# Optional: LLM fallback for the hybrid classifier.
# IMGA_LLM_FALLBACK_ENABLED=false
# IMGA_LLM_PROVIDER=gemini
# GEMINI_API_KEY=
